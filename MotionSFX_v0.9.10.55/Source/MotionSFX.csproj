<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Avoid the recursive WPF Page glob: the pre-build test harness copies a source
         XAML file into Tests/bin, which must not be compiled as a second MainWindow. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MotionSFX</AssemblyName>
    <RootNamespace>MotionSFX</RootNamespace>
    <ApplicationIcon>..\Assets\MotionSFX-icon.ico</ApplicationIcon>
    <Version>0.9.10.55</Version>
    <FileVersion>0.9.10.55</FileVersion>
    <AssemblyVersion>0.9.10.55</AssemblyVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- This is the application's only WPF Page. App.xaml remains the default ApplicationDefinition. -->
    <Page Include="UI\MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shortcut utility is a separate build-time console project, not part of MotionSFX.exe. -->
    <Compile Remove="BuildTools\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Managed Valve OpenVR bindings plus the matching x64 native runtime bridge. -->
    <PackageReference Include="JeppDev.OpenVR" Version="2.15.6" />
    <!-- SolarXR tracker metadata uses FlatBuffers over SlimeVR's local WebSocket data feed. -->
    <PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
    <!-- Persistent GPU texture updates avoid OpenVR's image-loading path on every dashboard refresh. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Assets\MotionSFX-logo.png" Link="Assets\MotionSFX-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\MotionSFX-icon.ico" Link="Assets\MotionSFX-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Config\settings.json" Link="Config\settings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Config\presets.json" Link="Config\presets.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Config\tracker-roles.json" Link="Config\tracker-roles.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Documentation\THIRD_PARTY_NOTICES.txt" Link="Documentation\THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ReportSuccessfulCompilationUnits" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="$(MOTIONSFX_ANSI_CYAN)    [COMPILED] %(Compile.Identity)$(MOTIONSFX_ANSI_RESET)" />
  </Target>
</Project>
