<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MotionSFX.ShortcutCreator</AssemblyName>
    <RootNamespace>MotionSFX.BuildTools</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <Target Name="ReportSuccessfulCompilationUnits" AfterTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="    [COMPILED] %(Compile.Identity)" />
  </Target>
</Project>
