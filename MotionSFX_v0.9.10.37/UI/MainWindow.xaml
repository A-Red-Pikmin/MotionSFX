                <ns4:Grid Grid.Row="2" Margin="0,0,0,10"><ns4:Grid.ColumnDefinitions><ns4:ColumnDefinition Width="300"/><ns4:ColumnDefinition Width="24"/><ns4:ColumnDefinition Width="260"/><ns4:ColumnDefinition Width="*"/></ns4:Grid.ColumnDefinitions><ns4:StackPanel><ns4:TextBlock Text="Target tracker role" FontWeight="Bold" Margin="0,0,0,4"/><ns4:ComboBox x:Name="PresetHipRole" Width="300" HorizontalAlignment="Left" Margin="0"/></ns4:StackPanel><ns4:StackPanel Grid.Column="2"><ns4:TextBlock Text="Sensitivity" FontWeight="Bold" Margin="0,0,0,4"/><ns4:ComboBox x:Name="PresetHipSensitivity" Width="240" HorizontalAlignment="Left" Margin="0"/></ns4:StackPanel></ns4:Grid>
                <ns4:StackPanel x:Name="PresetHipCustomPanel" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" Visibility="Collapsed">
                  <ns4:TextBlock Text="Custom" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                  <ns4:StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0"><ns4:TextBlock Text="Position threshold (units)" VerticalAlignment="Center" Margin="0,0,8,0"/><ns4:TextBox x:Name="PresetHipCustomPosition" Width="90" Height="32" VerticalContentAlignment="Center" ToolTip="Movement distance in the selected VMC coordinate space: avatar-scale for /Pos or device-raw for /Pos/Local fallback. Range: 0.001 to 2.0 units. Smaller values are more sensitive."/></ns4:StackPanel>
                  <ns4:StackPanel Orientation="Horizontal" VerticalAlignment="Center"><ns4:TextBlock Text="Rotation (degrees)" VerticalAlignment="Center" Margin="0,0,8,0"/><ns4:TextBox x:Name="PresetHipCustomRotation" Width="90" Height="32" VerticalContentAlignment="Center" ToolTip="Rotation change required to trigger. Range: 0.1 to 180 degrees. Smaller values are more sensitive."/></ns4:StackPanel>
