                <ns4:StackPanel Grid.Row="5" Margin="0,0,0,10"><ns4:TextBlock Text="Keyboard binding" FontWeight="Bold" Margin="0,0,0,4"/><ns4:TextBox x:Name="PresetHipHotkey" Style="{StaticResource KeybindCaptureBoxStyle}" Width="360" Height="36" HorizontalAlignment="Left" Margin="0"/><ns4:TextBlock Text="Click the box, then press a key or combination. Esc cancels; Backspace clears." Foreground="#9AA7B5" FontSize="11" Margin="2,4,0,0"/></ns4:StackPanel>
                <ns4:StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"><ns4:CheckBox x:Name="PresetHipEnabled" Content="Enable movement trigger" Margin="8,3,12,2" VerticalAlignment="Center"/><ns4:Button x:Name="PresetHipTest" Content="Test keybind" Tag="hip" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" FontWeight="Bold"/></ns4:StackPanel>
              </ns4:Grid>
            <ns4:ContentControl Grid.Column="1" x:Name="PresetHipPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4,12,14,10" VerticalAlignment="Top" HorizontalAlignment="Stretch"><ns4:ContentControl.LayoutTransform><ns4:ScaleTransform ScaleX="1.2" ScaleY="1.2"/></ns4:ContentControl.LayoutTransform></ns4:ContentControl></ns4:Grid></TabItem>
          </TabControl>
          <Border Grid.Row="2" Background="#171F2A" BorderBrush="#344154" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,8,0,0">
            <TextBlock Text="Thresholds: High 0.10 units / 6°, Normal 0.15 units / 10°, Low 0.20 units / 17°. Custom position and rotation thresholds remain independently configurable. Position values use avatar-scale coordinates for VMC /Pos and device-raw coordinates for /Pos/Local fallback; they are not guaranteed to be metres. Each preset has its own 0-10000 ms cooldown; 0 disables it. The optional global activation delay limits time between any two successful automatic shortcuts; 0 disables it. Either position OR rotation reaching its threshold causes an immediate movement attempt. The measurement baseline is updated after the attempt, including when a cooldown blocks it; no neutral-position or re-arm check is required. Legs are measured relative to Hip; Head and hands relative to Chest; Chest relative to Hip; Hip is measured in the incoming avatar/device coordinate frame. Manual Test keybinds do not use cooldowns." Foreground="#B7C2CF" TextWrapping="Wrap" FontSize="10"/>
          </Border>
        </Grid>
      </TabItem>




      <TabItem Header="Live View" Style="{StaticResource MainNavigationTabItemStyle}">
        <Grid Margin="12,14,12,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Live movement graphs" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="Live position and rotation measurements for all seven movement presets. These graphs use the same measurements, thresholds, and history as the individual preset pages." TextWrapping="Wrap" Foreground="#9AA7B5" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <UniformGrid Columns="3" Margin="0,0,8,0">
              <ContentControl x:Name="LiveRightFootPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
              <ContentControl x:Name="LiveLeftFootPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
              <ContentControl x:Name="LiveRightArmPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
              <ContentControl x:Name="LiveLeftArmPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
              <ContentControl x:Name="LiveHeadPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
              <ContentControl x:Name="LiveChestPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
              <ContentControl x:Name="LiveHipPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4"/>
            </UniformGrid>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Diagnostics" Style="{StaticResource MainNavigationTabItemStyle}">
        <Grid Margin="14,16,14,14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="Application diagnostics" FontSize="19" FontWeight="Bold"/>
            <TextBlock Text="The same timestamped messages are written to the command prompt and the log file." Foreground="#9AA7B5" FontSize="12" Margin="0,4,0,0"/>
          </StackPanel>
          <TextBox x:Name="LogView" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" FontFamily="Consolas" FontSize="11" Padding="10"/>
        </Grid>
      </TabItem>
    </TabControl>

    <Grid Grid.Row="2" Margin="2,8,2,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterLeft" Text="VMC UDP: 127.0.0.1:39539" Foreground="#7F8B99" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock x:Name="FooterRight" Grid.Column="1" Text="Ready" Foreground="#7F8B99" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
