<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MotionSFX.MainWindow" Title="MotionSFX Alpha 0.9.10.37" Height="800" Width="1280" MinHeight="800" MaxHeight="800" MinWidth="1280" MaxWidth="1280" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Background="#0D1117" Foreground="#E6EDF3" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#151B23"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#283241"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA7B5"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#9B7BFF"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F1FF"/>
      <Setter Property="Background" Value="#30264D"/>
      <Setter Property="BorderBrush" Value="#58458A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="Background" Value="#0D1117"/>
      <Setter Property="BorderBrush" Value="#354153"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="KeybindCaptureBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTip" Value="Click here, then press a key or key combination. Escape cancels; Backspace clears."/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="#C4B5FD"/>
      <Setter Property="Background" Value="#000000"/>
      <Setter Property="BorderBrush" Value="#755DC0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#C4B5FD"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                  <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ItemBorder" Property="Background" Value="#211638"/>
                      <Setter Property="Foreground" Value="#E1D6FF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="ItemBorder" Property="Background" Value="#30264D"/>
                      <Setter Property="Foreground" Value="#D0BFFF"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Foreground" Value="#746A8C"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
              <Border x:Name="ComboBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <ToggleButton x:Name="DropDownToggle" Width="30" HorizontalAlignment="Right" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="{TemplateBinding Background}" Padding="8,5">
                      <Path Fill="#C4B5FD" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 8 0 L 4 4 Z"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border Background="#000000" BorderBrush="#755DC0" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="ComboBoxBorder" Property="BorderBrush" Value="#A88BFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D9E0E8"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="8,3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MotionTabControlStyle" TargetType="{x:Type TabControl}">
      <Setter Property="Background" Value="#0D1117"/>
      <Setter Property="BorderBrush" Value="#283241"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,0,20,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="{TemplateBinding Background}" ClipToBounds="False"/>
              <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" KeyboardNavigation.DirectionalNavigation="Contained">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Explicit template prevents the Windows theme from replacing a selected
         tab with its default high-contrast black/white selection appearance. -->
    <Style TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="#AEB9C6"/>
      <Setter Property="Background" Value="#151B23"/>
      <!-- Symmetric padding keeps each header label geometrically centered. -->
      <Setter Property="Padding" Value="22,10,22,10"/>
      <!-- Keep TabItem's arranged slot flush; put inter-tab spacing inside its template. -->
      <Setter Property="Margin" Value="0"/>
      <Setter Property="ClipToBounds" Value="False"/>
      <Setter Property="BorderBrush" Value="#283241"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="None"
                       FontWeight="Bold" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <!-- This inner margin is the clipping fix: the TabPanel measures the gap
                 as part of the template instead of clipping an outer TabItem margin. -->
            <Grid Margin="0,0,22,0" SnapsToDevicePixels="True"
                  UseLayoutRounding="True" ClipToBounds="False">
              <Border x:Name="TabBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="9"
                      Padding="{TemplateBinding Padding}"
                      ClipToBounds="False" SnapsToDevicePixels="True">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#30264D"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#9B7BFF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="TabBorder" Property="Background" Value="#202936"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#58458A"/>
                <Setter Property="Foreground" Value="#E6EDF3"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Main navigation tabs use the same proven template and spacing behavior as
         nested tabs, with the same rounded outline and centered header text. -->
    <Style x:Key="MainNavigationTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#111720"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
      <Setter Property="BorderBrush" Value="#283241"/>
      <Setter Property="RowBackground" Value="#151B23"/>
      <Setter Property="AlternatingRowBackground" Value="#19212C"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#283241"/>
      <Setter Property="VerticalGridLinesBrush" Value="#283241"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowHeaderWidth" Value="0"/>
      <Setter Property="AlternationCount" Value="2"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#202936"/>
      <Setter Property="Foreground" Value="#B9C5D2"/>
      <Setter Property="BorderBrush" Value="#354153"/>
      <Setter Property="Padding" Value="9,8"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Foreground" Value="#E6EDF3"/>
    </Style>
  <DataTemplate x:Key="MovementPreviewGraphTemplate">
    <Border Background="#101720" BorderBrush="#6954A6" BorderThickness="1.5" CornerRadius="9" Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#F4F1FF"/>
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,4"/>
        <TextBlock Grid.Row="2" Text="{Binding TimingText}" Foreground="#9AA7B5" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,7"/>
        <StackPanel Grid.Row="3" Margin="0,0,0,7">
          <TextBlock Text="{Binding PositionText}" Foreground="#D7C8FF" FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap"/>
          <TextBlock Text="{Binding RotationText}" Foreground="#A9D7FF" FontFamily="Consolas" FontSize="10" Margin="0,3,0,0" TextWrapping="NoWrap"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,4">
          <Ellipse Width="8" Height="8" Fill="#A78BFA" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock Text="Position threshold (units)" Foreground="#D7C8FF" FontSize="9" VerticalAlignment="Center" Margin="0,0,13,0"/>
          <Ellipse Width="8" Height="8" Fill="#60A5FA" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock Text="Rotation" Foreground="#A9D7FF" FontSize="9" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="5" Background="#0B1119" BorderBrush="#28384A" BorderThickness="0" CornerRadius="4" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Canvas Width="306" Height="138" ClipToBounds="True" HorizontalAlignment="Center">
            <!-- Position uses the left axis in VMC position units. Rotation uses the right axis in degrees. -->
            <TextBlock Canvas.Left="0" Canvas.Top="0" Width="52" Text="POS · units" FontSize="8" FontWeight="Bold" Foreground="#D7C8FF" TextAlignment="Right"/>
            <TextBlock Canvas.Left="250" Canvas.Top="0" Width="56" Text="ROT · degrees" FontSize="8" FontWeight="Bold" Foreground="#A9D7FF" TextAlignment="Left"/>
            <TextBlock Canvas.Left="0" Canvas.Top="16" Width="52" Text="{Binding PositionAxisMaxText}" FontSize="8" Foreground="#9A8ABF" TextAlignment="Right"/>
            <TextBlock Canvas.Left="0" Canvas.Top="57" Width="52" Text="{Binding PositionAxisThresholdText}" FontSize="8" Foreground="#F4C95D" TextAlignment="Right"/>
            <TextBlock Canvas.Left="0" Canvas.Top="102" Width="52" Text="0.000" FontSize="8" Foreground="#738397" TextAlignment="Right"/>
            <TextBlock Canvas.Left="250" Canvas.Top="16" Width="56" Text="{Binding RotationAxisMaxText}" FontSize="8" Foreground="#8BB7E8" TextAlignment="Left"/>
            <TextBlock Canvas.Left="250" Canvas.Top="57" Width="56" Text="{Binding RotationAxisThresholdText}" FontSize="8" Foreground="#F4C95D" TextAlignment="Left"/>
            <TextBlock Canvas.Left="250" Canvas.Top="102" Width="56" Text="0.0" FontSize="8" Foreground="#738397" TextAlignment="Left"/>
            <Line X1="55" X2="248" Y1="17" Y2="17" Stroke="#263445" StrokeThickness="1"/>
            <Line X1="55" X2="248" Y1="39.5" Y2="39.5" Stroke="#202D3B" StrokeThickness="1"/>
            <Line X1="55" X2="248" Y1="62" Y2="62" Stroke="#F4C95D" StrokeThickness="1.4" StrokeDashArray="4,3"/>
            <Line X1="55" X2="248" Y1="84.5" Y2="84.5" Stroke="#202D3B" StrokeThickness="1"/>
            <Line X1="55" X2="248" Y1="107" Y2="107" Stroke="#263445" StrokeThickness="1"/>
            <Line X1="55" X2="55" Y1="17" Y2="107" Stroke="#415167" StrokeThickness="1"/>
            <Line X1="248" X2="248" Y1="17" Y2="107" Stroke="#415167" StrokeThickness="1"/>
            <Polyline Points="{Binding PositionGraphPoints}" Stroke="#A78BFA" StrokeThickness="2.2" StrokeLineJoin="Round"/>
            <Polyline Points="{Binding RotationGraphPoints}" Stroke="#60A5FA" StrokeThickness="2.2" StrokeLineJoin="Round"/>
            <TextBlock Canvas.Left="55" Canvas.Top="119" Text="Last 10 seconds · newest →" FontSize="8" Foreground="#738397"/>
          </Canvas>
        </Border>
      </Grid>
    </Border>
  </DataTemplate></Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="68"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="24"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="54" Height="54" CornerRadius="10" Background="#0D1117" BorderBrush="#D5C7FF" BorderThickness="2" Padding="2" Margin="0,0,13,0" ClipToBounds="True">
          <Image x:Name="AppLogo" Stretch="Uniform" SnapsToDevicePixels="True"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="MotionSFX" FontSize="25" FontWeight="ExtraBold" Foreground="#F4F1FF"/>
          <TextBlock Text="Native FBT Movement-to-Keybind Application." FontSize="12" Foreground="#9AA7B5" Margin="1,2,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="ALPHA 0.9.10.37" Foreground="#B9A7FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <Border Background="#151B23" BorderBrush="#283241" BorderThickness="1" CornerRadius="9" Padding="10,6">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="OverallStatusDot" Width="7" Height="7" Fill="#E0B55C" VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="OverallStatusText" Text="INITIALIZING" Foreground="#F5C451" FontSize="11" FontWeight="Bold"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <TabControl x:Name="MainTabs" Grid.Row="1" ClipToBounds="False" Style="{StaticResource MotionTabControlStyle}">
      <TabItem Header="Overview" Style="{StaticResource MainNavigationTabItemStyle}">
          <StackPanel Margin="12,14,12,12">
            <TextBlock Text="Connection overview" FontSize="19" FontWeight="Bold" Margin="2,0,0,5"/>
            <TextBlock Text="MotionSFX listens directly for SlimeVR VMC output. Reception is OFF until you start it." TextWrapping="Wrap" Foreground="#9AA7B5" Margin="2,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Button FontWeight="Bold" x:Name="StartReceivingButton" Content="Start receiving" MinWidth="150" Background="#315B43" BorderBrush="#4B8B65"/>
              <Button FontWeight="Bold" x:Name="StopReceivingButton" Content="Stop receiving" MinWidth="150" Background="#542B35" BorderBrush="#8B4655" IsEnabled="False" Opacity="0.45"/>
            </StackPanel>
            <UniformGrid Columns="3" Rows="1" Margin="0,0,0,18">
              <Border Background="#151B23" BorderBrush="#283241" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                <StackPanel>
                  <TextBlock Text="SLIMEVR" Foreground="#9AA7B5" FontSize="11" FontWeight="Bold"/>
                  <TextBlock x:Name="SlimeStatus" Text="Stopped" Foreground="#FF6B6B" FontSize="20" FontWeight="Bold" Margin="0,10,0,4"/>
                  <TextBlock x:Name="SlimeDetail" Text="Reception is stopped" Foreground="#9AA7B5" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Background="#151B23" BorderBrush="#283241" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                <StackPanel>
                  <TextBlock Text="STEAMVR" Foreground="#9AA7B5" FontSize="11" FontWeight="Bold"/>
                  <TextBlock x:Name="SteamStatus" Text="Checking..." Foreground="#F5C451" FontSize="20" FontWeight="Bold" Margin="0,10,0,4"/>
                  <TextBlock x:Name="SteamDetail" Text="Runtime process detection" Foreground="#9AA7B5" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Background="#151B23" BorderBrush="#283241" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4">
                <StackPanel>
                  <TextBlock Text="VMC INPUT" Foreground="#9AA7B5" FontSize="11" FontWeight="Bold"/>
                  <TextBlock x:Name="VmcStatus" Text="Stopped" Foreground="#FF6B6B" FontSize="20" FontWeight="Bold" Margin="0,10,0,4"/>
                  <TextBlock x:Name="VmcDetail" Text="Press Start receiving to begin" Foreground="#9AA7B5" FontSize="12"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <TextBlock Text="Live session" FontSize="17" FontWeight="Bold" Margin="2,0,0,10"/>
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,18">
              <Border Background="#151B23" CornerRadius="9" Padding="14" Margin="4">
                <StackPanel><TextBlock Text="UNIQUE VMC OUTPUTS" Foreground="#9AA7B5" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="MetricDevices" Text="0" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
              </Border>
              <Border Background="#151B23" CornerRadius="9" Padding="14" Margin="4">
                <StackPanel><TextBlock Text="LIVE VMC OUTPUTS" Foreground="#9AA7B5" FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="MetricLive" Text="0" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
              </Border>
              <Border Background="#151B23" CornerRadius="9" Padding="14" Margin="4">
                <StackPanel><TextBlock Text="VMC DATAGRAMS" Foreground="#9AA7B5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="MetricPackets" Text="0" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
              </Border>
              <Border Background="#151B23" CornerRadius="9" Padding="14" Margin="4">
                <StackPanel><TextBlock Text="MALFORMED" Foreground="#9AA7B5" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="MetricMalformed" Text="0" FontSize="25" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel>
              </Border>
            </UniformGrid>
            <Border Background="#171F2A" BorderBrush="#344154" BorderThickness="1" CornerRadius="9" Padding="15">
              <StackPanel>
                <TextBlock Text="Important" FontWeight="Bold" Foreground="#D9CCFF" Margin="0,0,0,5"/>
            <TextBlock Text="The counts shown here are unique VMC output identities, not physical IMU counts. SlimeVR's VMC stream reports tracker transforms and skeleton bones; it does not provide a physical sensor inventory. Assign tracker roles, enable movement presets, and save them to send their keybinds when motion is detected." TextWrapping="Wrap" Foreground="#B7C2CF"/>
              </StackPanel>
            </Border>
          </StackPanel>
      </TabItem>

      <TabItem Header="Trackers" Style="{StaticResource MainNavigationTabItemStyle}">
        <Grid Margin="12,14,12,12">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="2,0,2,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
              <TextBlock Text="Detected VMC outputs" FontSize="19" FontWeight="Bold"/>
              <TextBlock Text="Rows count distinct raw VMC identities; HMD, controller, tracker, and local/global variants merge into one row. This feed does not report how many physical IMUs are connected. Skeleton bones remain separate." TextWrapping="Wrap" Foreground="#9AA7B5" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <Button FontWeight="Bold" x:Name="ResetBodyRolesButton" Grid.Column="1" Content="Reset body roles" ToolTip="Remove all saved tracker-to-role assignments. Detected tracker rows are kept." Background="#542B35" BorderBrush="#8B4655" VerticalAlignment="Center"/>
            <Button FontWeight="Bold" x:Name="ClearDevicesButton" Grid.Column="2" Content="Clear session data" VerticalAlignment="Center"/>
          </Grid>
          <TabControl x:Name="TrackerDataTabs" Grid.Row="1" Margin="0,0,0,12" Style="{StaticResource MotionTabControlStyle}">
            <TabItem Header="VMC tracker outputs">
              <DataGrid x:Name="TrackerGrid" Margin="0,8,0,0" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" MinColumnWidth="55">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Raw VMC identity" Binding="{Binding vmcLabel}" Width="2*" MinWidth="120"/>
                  <DataGridTextColumn Header="VMC path type(s)" Binding="{Binding category}" Width="105" MinWidth="90"/>
                  <DataGridTextColumn Header="Assigned body role" Binding="{Binding role}" Width="125" MinWidth="105"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="75"/>
