                </ns4:StackPanel>
                <ns4:StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center"><ns4:TextBlock Text="Individual Cooldown (ms)" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/><ns4:TextBox x:Name="PresetChestCooldown" Width="82" MaxLength="5" Height="32" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" ToolTip="Minimum time before this preset can send another automatic shortcut. Range: 0 to 10000 ms. 0 disables the individual cooldown."/><ns4:TextBlock Text="0 = Disabled" Foreground="#9AA7B5" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/></ns4:StackPanel>
                <ns4:StackPanel Grid.Row="5" Margin="0,0,0,10"><ns4:TextBlock Text="Keyboard binding" FontWeight="Bold" Margin="0,0,0,4"/><ns4:TextBox x:Name="PresetChestHotkey" Style="{StaticResource KeybindCaptureBoxStyle}" Width="360" Height="36" HorizontalAlignment="Left" Margin="0"/><ns4:TextBlock Text="Click the box, then press a key or combination. Esc cancels; Backspace clears." Foreground="#9AA7B5" FontSize="11" Margin="2,4,0,0"/></ns4:StackPanel>
                <ns4:StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"><ns4:CheckBox x:Name="PresetChestEnabled" Content="Enable movement trigger" Margin="8,3,12,2" VerticalAlignment="Center"/><ns4:Button x:Name="PresetChestTest" Content="Test keybind" Tag="chest" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0" FontWeight="Bold"/></ns4:StackPanel>
              </ns4:Grid>
            <ns4:ContentControl Grid.Column="1" x:Name="PresetChestPreview" ContentTemplate="{StaticResource MovementPreviewGraphTemplate}" Margin="4,12,14,10" VerticalAlignment="Top" HorizontalAlignment="Stretch"><ns4:ContentControl.LayoutTransform><ns4:ScaleTransform ScaleX="1.2" ScaleY="1.2"/></ns4:ContentControl.LayoutTransform></ns4:ContentControl></ns4:Grid></TabItem>
            <TabItem Header="Hip Movement">
              <ns4:Grid Margin="0"><ns4:Grid.ColumnDefinitions><ns4:ColumnDefinition Width="*"/><ns4:ColumnDefinition Width="450"/></ns4:Grid.ColumnDefinitions><ns4:Grid Margin="14,12,10,10" Grid.Column="0">
                <ns4:Grid.RowDefinitions><ns4:RowDefinition Height="Auto"/><ns4:RowDefinition Height="Auto"/><ns4:RowDefinition Height="Auto"/><ns4:RowDefinition Height="Auto"/><ns4:RowDefinition Height="Auto"/><ns4:RowDefinition Height="Auto"/><ns4:RowDefinition Height="*"/></ns4:Grid.RowDefinitions>
                <ns4:TextBlock Text="Hip Movement" FontSize="21" FontWeight="Bold" Foreground="White" Margin="0,0,0,3"/>
